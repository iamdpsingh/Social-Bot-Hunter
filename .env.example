# Social Bot Hunter — Environment Configuration Template
# Values with sensitive credentials must remain empty by default.
# Replace CHANGE_ME placeholders in your local .env file before running against services.

# Application Environment
SBH_ENV=development
SBH_DATABASE_URL=sqlite:///./sbh-dev.sqlite
# For PostgreSQL: postgresql://sbh_user:CHANGE_ME@localhost:5432/sbh
SBH_CONFIG_PATH=src/sbh/resources/detection.v1.yaml
SBH_MIGRATIONS_DIR=db/migrations
SBH_LOG_LEVEL=INFO

# Platform API Credentials (kept blank in repo; populate in private .env only)
# X / Twitter
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Instagram Graph API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# TikTok for Developers
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# YouTube Data API v3
YOUTUBE_API_KEY=

# LinkedIn Community Management API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Local Storage & Runtime Environment
SBH_SNAPSHOT_DIR=./data/snapshots
SBH_EXPORT_DIR=./data/exports
SBH_MODELS_DIR=./data/models
